#!/usr/bin/env bash
set -eo pipefail

SRC="data/material.yaml"
DEST="data/autogenerated.json"
API="https://www.youtube.com/youtubei/v1/player?key=AIzaSyAO_FJ2SlqU8Q4STEHLGCilw_Y9_11qcW8"
CLIENT_NAME="WEB"
CLIENT_VERSION="2.20250201.00.00"

# 0. Verify if the source file is staged for commit; if not, exit without doing anything
[ -f "$SRC" ] && ! git diff --cached --quiet -- "$SRC" || exit 0

mkdir -p "${DEST%/*}"
# 1. Extraction (jq) -> 2. Loop (bash) -> 3. Curl + Parsing (jq) -> 4. Aggregation (jq)
(
  for id in $(jq -Rrs '[scan("(?:v=|shorts/|embed/|youtu\\.be/)([\\w-]{11})")[]] | unique[]' "$SRC"); do
    body=$(jq -nc --arg id "$id" --arg cn "$CLIENT_NAME" --arg cv "$CLIENT_VERSION" \
      '{context: {client: {clientName: $cn, clientVersion: $cv}}, videoId: $id}')
    curl -sS -X POST "$API" \
      -H "Content-Type: application/json" \
      --data "$body" \
    | jq -c --arg id "$id" '
        {
          ($id): {
            title: (.videoDetails.title // null),
            duration: (.videoDetails.lengthSeconds | tonumber? // null),
            thumb: (((.videoDetails.thumbnail.thumbnails // []) | last | .url) // "https://i.ytimg.com/vi/\($id)/hqdefault.jpg")
          }
        }' &
  done
  wait
) | jq -s 'add' > "$DEST"

git add -- "$DEST"
